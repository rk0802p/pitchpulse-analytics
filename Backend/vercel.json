{
  "version": 2,
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "data/baselines/*.json",
          "data/seasons/**/*.csv"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11",
    "VERCEL_ANALYZE_BUILD_OUTPUT": "1"
  }
}
